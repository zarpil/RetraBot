# Dockerfile para el Backend (Bot de Discord + Express API)
FROM node:20-alpine AS builder

# Instalar openssl, fontconfig y fuentes tipográficas para soporte de Canvas en Alpine Linux
RUN apk add --no-cache openssl fontconfig font-dejavu ttf-dejavu

WORKDIR /app

# Copiar paquetes e instalar dependencias
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY bot/package*.json ./bot/
COPY shared/prisma ./shared/prisma

RUN npm ci

# Copiar código fuente
COPY shared ./shared
COPY bot ./bot

# Generar Prisma Client y compilar shared y bot
RUN npx prisma generate --schema=./shared/prisma/schema.prisma
RUN npm run build --workspace=shared
RUN npm run build --workspace=bot

# Imagen final de producción
FROM node:20-alpine AS runner

# Instalar openssl, fontconfig y fuentes tipográficas en la imagen final
RUN apk add --no-cache openssl fontconfig font-dejavu ttf-dejavu

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
COPY shared/package*.json ./shared/
COPY bot/package*.json ./bot/

COPY --from=builder /app/shared ./shared
COPY --from=builder /app/bot/dist ./bot/dist
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 48931

CMD ["sh", "-c", "npx prisma db push --schema=./shared/prisma/schema.prisma && node bot/dist/index.js"]
